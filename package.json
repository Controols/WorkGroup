{
  "name": "worksgroup-checks",
  "version": "1.0.0",
  "private": true,
  "description": "Dev-only test harness for the three Works Group sites. Nothing here ships — the sites stay plain HTML with no build step.",
  "scripts": {
    "sweep": "playwright test",
    "sweep:overflow": "playwright test overflow",
    "sweep:linen": "playwright test -g linen-works",
    "sweep:cleaning": "playwright test -g cleaning-works",
    "sweep:group": "playwright test -g works-group",
    "report": "playwright show-report tests/__report",
    "serve": "node tools/static-server.js",
    "precopy": "node tools/precopy.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
}
